node_modules
.env
.env.*
dist
build
coverage
.DS_Store
apps/server/data/*.json
apps/server/data/*.db
# Pre-reset copies of the local store, written by scripts/reset-dev-data.mjs.
# The glob above stops at the data dir itself, and these are the same local
# task data one level down.
apps/server/data/backups/
# Any other store one level down. Running a second dev server against an
# isolated DATA_FILE is the normal way to look at a branch without touching
# your own data, and it lands a whole store in a subdirectory here — which the
# two globs above do not reach, so a `git add -A` swept one into a commit.
apps/server/data/*/
npm-debug.log*
yarn-error.log*
pnpm-lock.yaml
teams-app/manifest.generated.json
teams-app/*.zip

# TS incremental build info
*.tsbuildinfo

# Throwaway debug harnesses. Disposable by design — they answer one question
# and get deleted, so they never belong in history.
scripts/debug/

# Agent worktrees. AGENTS.md puts them here so they stop landing in ~/repos and
# reading as new projects; they are checkouts, not sources.
.claude/worktrees/

# A saved copy of a real Humperdink loan details page, kept as the selector
# reference for tools/humperdink/. ~1.3 MB of markup plus a few hundred asset
# files, and it is customer data — save your own, keep it out of history.
humperdinkscrape/

# Session working notes. Dispatch logs, triage scratch, half-formed plans —
# they record queue state that is wrong the moment it lands, so they are read
# once and thrown away. Same reasoning as scripts/debug/ above.
.scratch/

# Impeccable design-tool state — local to a machine, not part of the repo.
# `**/` because the tool writes a directory at the repo root and another under
# each app it is pointed at.
# The one deliberate exception is apps/web/.impeccable/design.json, which is not
# matched here: it is the machine-readable half of apps/web/DESIGN.md and
# belongs with it.
**/.impeccable/config.json
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json
**/.impeccable/live/
# The tool writes this itself, from its own template, whenever it runs here.
apps/web/.gitignore
